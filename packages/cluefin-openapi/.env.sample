KIWOOM_APP_KEY=your_app_key_here
KIWOOM_SECRET_KEY=your_secret_key_here
KIWOOM_ENV=your_environment_here e.g: dev or prod
DART_AUTH_KEY=your_auth_key_here
KIS_APP_KEY=your_kis_app_key_here
KIS_SECRET_KEY=your_kis_secret_key_here
KIS_ENV=your_kis_environment_here e.g: dev or prod
# Optional: Real HTS user ID for watchlist integration tests
KIS_HTS_USER_ID=
NHPLUG_APP_KEY=your_nhplug_app_key_here
NHPLUG_SECRET_KEY=your_nhplug_secret_key_here
# NHPLUG_ENV selects the query/order domain only (prod: api.nhplug.com, dev: moapi.nhplug.com mock).
# Token issuance is always prod-only; one token works on both domains.
NHPLUG_ENV=your_nhplug_environment_here e.g: dev or prod
